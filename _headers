# ===== 立欣診所網站 _headers（Netlify 安全標頭設定）=====
# 套用到全站所有頁面，提升安全性與專業度

/*
  # 防止網站被嵌入他人 iframe（避免點擊劫持 clickjacking）
  X-Frame-Options: SAMEORIGIN
  # 防止瀏覽器誤判檔案類型（MIME 混淆攻擊）
  X-Content-Type-Options: nosniff
  # 控制 referrer 資訊外洩程度（保護使用者隱私）
  Referrer-Policy: strict-origin-when-cross-origin
  # 強制瀏覽器後續一律走 HTTPS（含子網域），效期一年
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # 限制可使用的瀏覽器功能（診所網站不需要這些感測器/裝置權限）
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  # CSP（2026-11-26c）：第一階段 Report-Only，只回報不阻擋；Deploy Preview 確認零違規後換正式版。
  # 白名單依據與驗收點見 /_headers_proposed.txt（兩檔的 policy 必須逐字一致）。
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com; media-src 'self' blob:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com; frame-src 'self' https://maps.google.com https://www.google.com https://www.youtube-nocookie.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

# ── 靜態資源快取（圖片、PDF）：加速回訪載入 ──
/images/*
  Cache-Control: public, max-age=2592000

/docs/*
  Cache-Control: public, max-age=2592000

# ── 減重營養課學員專區（2026-11-09）：不給搜尋引擎收錄 ──
/members/*
  X-Robots-Tag: noindex, nofollow, noarchive

# ── IndexNow 金鑰檔：確保純文字、可被搜尋引擎讀取 ──
/631da727697dc88a64a8f0b76042c891.txt
  Content-Type: text/plain; charset=utf-8

